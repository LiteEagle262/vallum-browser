{
  "name": "@vallum/browser",
  "version": "0.1.0",
  "description": "Zero-build browser bundle for the Vallum SDK",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vallum-proxy/vallum.git",
    "directory": "packages/vallum-browser"
  },
  "homepage": "https://github.com/vallum-proxy/vallum#readme",
  "bugs": "https://github.com/vallum-proxy/vallum/issues",
  "keywords": ["vallum", "browser", "vanilla-js", "html", "security", "sdk"],
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/index.js",
  "unpkg": "./dist/vallum.iife.js",
  "jsdelivr": "./dist/vallum.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vallum.esm.js": "./dist/vallum.esm.js",
    "./vallum.iife.js": "./dist/vallum.iife.js"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.iife.config.ts && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run",
    "prepack": "npm run build && node ../../scripts/prepare-package-license.mjs .",
    "postpack": "node ../../scripts/cleanup-package-license.mjs ."
  },
  "dependencies": { "@vallum/client": "^0.1.0" },
  "devDependencies": { "vite": "^8.2.1", "vitest": "^4.1.10", "typescript": "^5.9.2" },
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public", "provenance": true }
}
